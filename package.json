{
    "name": "arc-timer",
    "version": "1.2.0",
    "main": "expo-router/entry",
    "scripts": {
        "start": "APP_VARIANT=development expo start",
        "start:production": "APP_VARIANT=production expo start",
        "db:generate": "drizzle-kit generate --name",
        "ios": "APP_VARIANT=development npm run guard:dev-variant && APP_VARIANT=development expo run:ios -d",
        "ios:build:dev": "APP_VARIANT=development npm run guard:dev-variant && APP_VARIANT=development expo run:ios -d --configuration Release",
        "android": "APP_VARIANT=development npm run guard:dev-variant && APP_VARIANT=development expo run:android -d",
        "android:build:dev": "APP_VARIANT=development npm run guard:dev-variant && APP_VARIANT=development expo run:android -d --variant release",
        "web": "APP_VARIANT=development expo start --web",
        "lint": "eslint . --ext .ts,.tsx",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm run lint",
        "expo:check": "expo install --check",
        "release:check": "npm run check && npm run expo:check && npx expo-doctor",
        "release:permissions": "node scripts/inspect-native-permissions.js",
        "export:ios": "APP_VARIANT=production expo export --clear --platform ios --output-dir /private/tmp/arc-timer-ios-export",
        "export:android": "APP_VARIANT=production expo export --clear --platform android --output-dir /private/tmp/arc-timer-android-export",
        "release:ios:check": "npm run release:check && npm run export:ios",
        "release:android:check": "npm run release:check && npm run export:android",
        "native:generate": "rm -rf ios android && APP_VARIANT=production npx expo prebuild --clean",
        "native:generate:dev": "rm -rf ios android && APP_VARIANT=development npx expo prebuild --clean",
        "native:generate:screenshots": "APP_VARIANT=screenshots expo prebuild --clean",
        "guard:prod-variant": "node scripts/check-variant.js production",
        "guard:dev-variant": "node scripts/check-variant.js development",
        "guard:screenshots-variant": "node scripts/check-variant.js screenshots",
        "ios:open": "open ios/*.xcworkspace",
        "ios:release": "APP_VARIANT=production npm run guard:prod-variant && APP_VARIANT=production expo run:ios -d --configuration Release",
        "ios:screenshots": "APP_VARIANT=screenshots expo run:ios -d --configuration Release",
        "android:clean": "cd android && ./gradlew clean",
        "android:release:device": "APP_VARIANT=production npm run guard:prod-variant && APP_VARIANT=production expo run:android -d --variant release",
        "android:release:apk": "APP_VARIANT=production npm run guard:prod-variant && cd android && APP_VARIANT=production ./gradlew assembleRelease",
        "android:release:aab": "APP_VARIANT=production npm run guard:prod-variant && cd android && APP_VARIANT=production ./gradlew bundleRelease",
        "android:install:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
        "android:screenshots": "APP_VARIANT=screenshots expo run:android -d --variant release",
        "assets:classic": "node scripts/generate-classic-assets.js",
        "i18n:keys": "node scripts/generate-i18n-keys.js",
        "cleaner": "node scripts/cleaner.js",
        "cleaner:hard": "node scripts/cleaner.js --hard"
    },
    "dependencies": {
        "@expo-google-fonts/days-one": "^0.4.0",
        "@expo/vector-icons": "^15.0.2",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@tanstack/react-query": "^5.100.9",
        "base-64": "^1.0.0",
        "date-fns": "^4.1.0",
        "drizzle-orm": "^0.45.2",
        "expo": "58.0.21",
        "expo-application": "~58.1.2",
        "expo-asset": "~58.0.19",
        "expo-audio": "~58.0.10",
        "expo-constants": "~58.0.14",
        "expo-dev-client": "~58.0.17",
        "expo-document-picker": "~58.0.4",
        "expo-file-system": "~58.0.13",
        "expo-font": "~58.0.11",
        "expo-keep-awake": "~58.0.3",
        "expo-linear-gradient": "~58.0.3",
        "expo-linking": "~58.0.15",
        "expo-localization": "~58.0.5",
        "expo-notifications": "~58.1.7",
        "expo-router": "~58.0.28",
        "expo-sharing": "~58.0.21",
        "expo-splash-screen": "~58.0.12",
        "expo-sqlite": "~58.0.14",
        "expo-status-bar": "~58.0.4",
        "expo-system-ui": "~58.0.7",
        "i18next": "^25.10.8",
        "immer": "^10.2.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-i18next": "^16.6.5",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-svg": "15.16.0",
        "react-native-view-shot": "6.1.1",
        "react-native-worklets": "0.13.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@react-native/eslint-config": "0.88.1",
        "@types/better-sqlite3": "7.6.13",
        "@types/jest": "^30.0.0",
        "@types/react": "~19.3.0",
        "babel-plugin-inline-import": "^3.0.0",
        "babel-plugin-module-resolver": "^5.0.2",
        "babel-preset-expo": "~58.0.22",
        "better-sqlite3": "12.9.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.0",
        "expo-drizzle-studio-plugin": "^0.2.1",
        "jest": "^30.2.0",
        "jest-expo": "~58.0.13",
        "jimp-compact": "0.16.1",
        "react-test-renderer": "19.3.0",
        "typescript": "~6.0.3"
    },
    "private": true,
    "engines": {
        "npm": ">=11.10.0",
        "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=11.10.0",
            "onFail": "error"
        }
    },
    "overrides": {
        "esbuild": "0.25.12",
        "postcss": "8.5.10"
    },
    "packageManager": "npm@11.14.1",
    "volta": {
        "node": "22.13.0",
        "npm": "11.14.1"
    }
}
