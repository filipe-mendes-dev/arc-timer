<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gym_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/gym_session_card" android:clipToOutline="true">
    <ImageView android:id="@+id/gym_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/gym_session_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/gym_watermark" android:layout_width="174dp" android:layout_height="131dp"
        android:layout_gravity="end|bottom" android:src="@drawable/arc_notification_watermark" android:alpha="0.12"
        android:translationX="20dp" android:translationY="14dp"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/gym_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/gym_plan" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:paddingStart="10dp">
                <Chronometer android:id="@+id/gym_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
                <TextView android:id="@+id/gym_elapsed_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/gym_started" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
            <FrameLayout android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp">
                <ImageView android:id="@+id/gym_end_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/gym_session_button" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <TextView android:id="@+id/gym_end" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="16dp" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
