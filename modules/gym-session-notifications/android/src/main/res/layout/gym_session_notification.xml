<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gym_root" android:layout_width="match_parent" android:layout_height="48dp"
    android:background="@drawable/gym_session_card" android:clipToOutline="true">
    <ImageView android:id="@+id/gym_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/gym_session_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/gym_watermark" android:layout_width="100dp" android:layout_height="76dp"
        android:layout_gravity="end|bottom" android:src="@drawable/arc_notification_watermark" android:alpha="0.12"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/gym_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/gym_plan" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:paddingStart="8dp">
            <Chronometer android:id="@+id/gym_timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
            <TextView android:id="@+id/gym_elapsed_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
